@import "~/.cache/rofi/colors.rasi"

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "drun Search";
    drun-display-format:        "{name} <i>({generic})</i>";
    font:                       "JetBrainsMono Nerd Font 11";
}

* {
    /* Dynamic Pywal / Quickshell Linked Variables */
    bg-col:                     @background;
    bg-col-light:               @background-alt;
    border-col:                 @selected;
    
    /* Text & Highlight Variables */
    main-text:                  @foreground;
    active-accent:              @selected;
    urgent-accent:              @urgent;

    background-color:           transparent;
    text-color:                 @main-text;
    margin:                     0;
    padding:                    0;
}

window {
    height:                     520px;
    width:                      600px;
    border:                     2px;
    border-color:               @border-col;
    border-radius:              24px;
    background-color:           @bg-col;
}

mainbox {
    spacing:                    15px;
    padding:                    24px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    spacing:                    10px;
    padding:                    12px 18px;
    border-radius:              18px;
    background-color:           @bg-col-light;
    children:                   [ "entry" ];
}

entry {
    placeholder:                "drun Search";
    placeholder-color:          @background-alt;
    text-color:                 @main-text;
    background-color:           transparent;
}

listview {
    columns:                    1;
    lines:                      7;
    spacing:                    8px;
    cycle:                      true;
    dynamic:                    true;
    layout:                     vertical;
    background-color:           transparent;
}

element {
    padding:                    10px 14px;
    border-radius:              14px;
    spacing:                    14px;
    background-color:           transparent;
    text-color:                 @main-text;
    children:                   [ "element-icon", "element-text" ];
}

/* Force unselected elements to stay transparent */
element normal.normal,
element normal.active,
element alternate.normal,
element alternate.active {
    background-color:           transparent;
    text-color:                 @main-text;
}

element-icon {
    size:                       32px;
    background-color:           transparent;
}

element-text {
    vertical-align:             0.5;
    background-color:           transparent;
    text-color:                 inherit;
}

/* Dynamic Accent Highlight on Selection */
element selected.normal,
element selected.active {
    background-color:           @active-accent;
    border:                     1px;
    border-color:               @border-col;
    text-color:                 @background;
}

element selected.urgent {
    background-color:           @urgent-accent;
    text-color:                 #FFFFFF;
}