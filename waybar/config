{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar",
        "cpu",
        "custom/gpu",
        "memory"
    ],
    "modules-center": [
        "mpris",
        "cava"
    ],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "clock",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "icon-theme": "Numix-Circle",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "tooltip": true
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo 0",
        "format": "󰢮 {}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 2,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "mpris": {
        "format": "<b>{player_icon} {title}</b> - <i>{artist}</i>",
        "format-paused": "<b>{status_icon} {title}</b> - <i>{artist}</i>",
        "player-icons": {
            "default": "󰎈",
            "spotify": "",
            "brave": "🦁"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 35,
        "on-click": "playerctl play-pause"
    },

    "cava": {
        "framerate": 60,
        "autosens": 1,
        "bars": 12,
        "method": "pipewire",
        "source": "auto",
        "format-icons" : [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰤭 Disconnected",
        "on-click": "nm-connection-editor"
    },

    "tray": {
        "spacing": 10
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    }
}